# --- Firebase client SDK (safe to expose, used in the browser) ---
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only — from your service account JSON) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines if setting this in a
# single-line env (e.g. Vercel dashboard). The code converts \n back to real
# newlines at runtime.
FIREBASE_PRIVATE_KEY=

# --- Paystack ---
PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
